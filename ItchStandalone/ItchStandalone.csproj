<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>ItchStandalone</AssemblyName>
    <RootNamespace>ItchStandalone</RootNamespace>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU</Platforms>
    <LangVersion>9.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.11.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="CliWrap" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- AssemblyInfo is automatically included by SDK style project from file system -->
  </ItemGroup>

</Project>
